{
  "version": 1,
  "skipApplyDocRegex": "^(APPLY_AND_VERIFY|UPGRADE_.*|PATCH_NOTES|README_PATCH)\\.md$",
  "presets": [
    {
      "name": "基础必传集 (README + 核心检索)",
      "paths": [
        "README.md",
        "_build/rs/compute_intensive_task_processor/src/lib.rs",
        "src/js/raw/worker.js",
        "src/js/raw/search-engine.js",
        "src/js/raw/search-ui.js"
      ]
    },
    {
      "name": "安全加固与协议桥全套",
      "paths": [
        "README.md",
        ".gitignore",
        "_build/CLI.bat",
        "_build/protocol_guard.ps1",
        "_build/config.properties",
        "_build/server/sws.toml",
        "_build/server/sws-sim.toml",
        "src/js/raw/site-core.js",
        "src/js/raw/shared-utils.js",
        "src/js/raw/index.js"
      ]
    },
    {
      "name": "电子书阅读器 (PDF / EPUB / TXT)",
      "paths": [
        "README.md",
        "src/tpl/pdf.html",
        "src/tpl/epub.html",
        "src/tpl/txt.html",
        "src/js/raw/pdf-viewer.js",
        "src/css/raw/pdf-viewer.css",
        "src/third/pdfjs/web/viewer.mjs",
        "src/third/bibi/presets/default.js",
        "src/js/raw/book-db.js",
        "src/js/raw/search-preview.js",
        "src/js/raw/shared-utils.js"
      ]
    },
    {
      "name": "HTML 正文 / 高亮 / Diff / 双语",
      "paths": [
        "README.md",
        "src/js/raw/content.js",
        "src/js/raw/bilingual.js",
        "src/tpl/bilingual.html",
        "src/js/raw/shared-utils.js",
        "src/js/raw/site-core.js"
      ]
    },
    {
      "name": "SW 缓存 / 热更新 / 构建清单",
      "paths": [
        "README.md",
        "index.html",
        "src/js/raw/site-core.js",
        "src/js/raw/index.js",
        "src/js/raw/sw.js",
        "src/js/raw/snapshot.js",
        "_build/config.properties",
        "_build/jar/Generator.java",
        "_build/jar/Config.java"
      ]
    },
    {
      "name": "近义词构建与调优",
      "paths": [
        "README.md",
        "_build/jar/SynonymBuilder.java",
        "_build/synonyms/synonyms_custom.json",
        "_build/synonyms/oov_report.txt",
        "src/js/raw/worker.js"
      ]
    },
    {
      "name": "全部前端源码 (raw JS/CSS + tpl + index)",
      "globs": [
        "index.html",
        "README.md",
        ".gitignore",
        "src/js/raw/*.js",
        "src/css/raw/*.css",
        "src/tpl/*.html"
      ]
    }
  ]
}
